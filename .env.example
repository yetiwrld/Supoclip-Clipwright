# ClipWright Studio Environment Configuration
# Offline-first: no AI API key is required. Local Whisper transcribes and a
# local Ollama model analyses the transcript.
#
# Copy this file to .env, then run:  python scripts/setup_local_ai.py
# The setup script fills in the model paths and downloads the Whisper model.

# ==============================================
# Local AI (default — works with no internet)
# ==============================================

# Offline mode. true = no hosted AI provider is ever contacted, and no analytics
# or error-reporting service is contacted either (DataFast, Tilly, PostHog,
# session replay). Set to false *and* ALLOW_HOSTED_AI=true, plus the relevant
# keys below, only if you deliberately want cloud AI and telemetry.
OFFLINE_MODE=true
ALLOW_HOSTED_AI=false
# Runtime-settings directory shared with the frontend container; the Offline
# Mode switch in Settings is stored here as offline-mode.json.
# CLIPWRIGHT_CONFIG_DIR=./data/config

# Transcription provider: whisper (default, local), youtube_captions, or assemblyai
# - whisper: local transcription, no API key, word-level timestamps
# - youtube_captions: read captions for YouTube links (needs the internet)
# - assemblyai: hosted API (requires ASSEMBLY_AI_API_KEY + ALLOW_HOSTED_AI)
TRANSCRIPTION_PROVIDER=whisper

# Whisper checkpoint kept on disk. `small` is the default; use `base` if the
# Ryzen 5 4600U is too slow, or `medium` for better accuracy.
WHISPER_MODEL_SIZE=small
# Where checkpoints live. Persisted so restarts never re-download.
# Docker compose mounts this path from ./data/models/whisper.
WHISPER_MODEL_DIR=./data/models/whisper
# Whisper accelerates only on CUDA; CPU is the default for AMD/Intel machines.
WHISPER_DEVICE=cpu
# Root for every local model file (Whisper today, anything else later).
MODELS_DIR=./data/models

# Root for everything user-generated: uploads, renders, models and the runtime
# settings file written by Settings → Offline & local AI. Docker compose mounts
# ${CLIPWRIGHT_DATA_DIR:-./data}/{uploads,clips,models,config}.
CLIPWRIGHT_DATA_DIR=./data
# Where the runtime settings file lives (offline mode switch). Inside Docker
# compose this is /config; outside Docker it defaults to $CLIPWRIGHT_DATA_DIR/config.
# CLIPWRIGHT_CONFIG_DIR=./data/config

# Local language model used for clip selection, titles/hooks and AI editing.
# Requires Ollama (https://ollama.com/download) with the model pulled:
#   ollama pull llama3.2:3b
LLM=ollama:llama3.2:3b
# Optional: editor-only model (defaults to the same local model).
AI_EDIT_MODEL=ollama:llama3.2:3b
# Optional model for the cross-window rerank of clip candidates (empty = LLM).
RERANK_LLM=

# Wall-clock budget, in seconds, for ONE transcript-analysis window. Local
# CPU-only models (llama3.2:3b on a Ryzen 5 4600U) often need more than the old
# hard-coded 600s for a 12-minute window, so the default is 1800 (30 minutes).
# Raise it for slower machines or bigger models; lower it to fail faster.
# Values below 60 or above 21600 are clamped, and invalid values fall back to
# 1800. The ARQ worker job timeout and the Ollama HTTP read timeout both follow
# this value, so no smaller timeout cuts a window short.
AI_ANALYSIS_TIMEOUT_SECONDS=1800
# Optional hard cap, in seconds, for all analysis windows together. Leave empty
# (or 0) to derive it from the window count: one per-window budget per batch of
# three windows. It can raise that derived total but never shrink it below a
# single window's budget.
AI_ANALYSIS_TOTAL_TIMEOUT_SECONDS=

# Ollama must be running. Inside Docker, the backend reaches the host daemon
# through host.docker.internal. Outside Docker, localhost is used.
# Leave empty to auto-detect (localhost:11434 in a process, host.docker.internal
# in a container). Set explicitly if Ollama listens elsewhere.
OLLAMA_BASE_URL=
# Only needed for an authenticated/proxied Ollama; local Ollama needs no key.
OLLAMA_API_KEY=
# Avoid CUDA/NVIDIA dependency downloads on CPU-only Docker hosts (including Macs).
# Existing deployments without this setting retain their current Torch variant.
BACKEND_CPU_ONLY=true
# Image platform for the backend and worker. linux/amd64 is the default,
# including on Apple Silicon, where Docker emulates it. On an arm64 host, set
# linux/arm64 and keep BACKEND_CPU_ONLY=true (CUDA wheels are amd64-only),
# then rebuild: docker compose up -d --build backend worker
BACKEND_PLATFORM=linux/amd64

# AssemblyAI - OPTIONAL hosted service. Only used when you explicitly set
# TRANSCRIPTION_PROVIDER=assemblyai *and* OFFLINE_MODE=false + ALLOW_HOSTED_AI=true.
# The local Whisper provider needs no key.
ASSEMBLY_AI_API_KEY=
# Total status-polling budget after transcript submission, in seconds.
ASSEMBLY_AI_HTTP_TIMEOUT_SECONDS=900
# Bound individual upload/submit HTTP requests; transient uploads retry up to 3 times.
ASSEMBLY_AI_REQUEST_TIMEOUT_SECONDS=60

# Spoken language of uploads. Leave empty (or "auto") to detect it per video.
# Set an AssemblyAI language code (e.g. es, de, pt, en_us) to force it; this
# also picks the matching audio track in multi-track files. Applies to Whisper too.
TRANSCRIPTION_LANGUAGE=

# Max accepted size (bytes) for an uploaded video. Default 4 GB (4000000000),
# enough for a full-length 1080p upload at a normal bitrate. Larger files make
# transcription, storage, and rendering slow and fragile.
# The web app reads the same value from the billing summary. Set
# NEXT_PUBLIC_MAX_VIDEO_UPLOAD_BYTES to this number as well so the pre-upload
# check matches before that summary loads.
MAX_VIDEO_UPLOAD_BYTES=4000000000

# ---------------------------------------------------------------------------
# OPTIONAL hosted AI providers. Disabled by default; ClipWright Studio never
# contacts them unless OFFLINE_MODE=false and ALLOW_HOSTED_AI=true. Leaving
# every key below empty is the supported, fully offline configuration.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# OpenRouter: Sonnet 5.5 primary, GPT-6 Luna fallback
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=openai/gpt-6-luna

# Google AI (recommended: gemini-3-flash)
GOOGLE_API_KEY=

# Anthropic (claude-3-5-sonnet, claude-4-sonnet)
ANTHROPIC_API_KEY=

# Pexels - For AI B-Roll (free stock video footage)
# Get your free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional paid fallback for YouTube downloads
APIFY_API_TOKEN=

# YouTube download provider
# `yt_dlp` is the free default and works without APIFY_API_TOKEN.
# `apify` uses the Apify actor first, then falls back to yt-dlp.
# `rapidapi` tries API Router, then Apify, then yt-dlp.
# When YOUTUBE_PROXY_URL is configured, the order is proxy, API Router, Apify, yt-dlp.
YOUTUBE_DOWNLOAD_PROVIDER=yt_dlp

# Residential proxy for yt-dlp. Empty keeps the existing provider chain.
# `{session}` is replaced with a per-job sticky id (one exit IP per job).
# `{country}` is optional and must be a two-letter code when set below.
# Example: http://user-country-{country}-session-{session}:pass@gw.example:823
YOUTUBE_PROXY_URL=
TWITCH_DOWNLOAD_PROVIDERS=proxy,direct,apify_twitch
KICK_DOWNLOAD_PROVIDERS=proxy,direct_retry,apify_kick_hls,apify_kick_mp4
APIFY_STREAM_PROVIDERS=true
APIFY_TWITCH_ACTOR=abotapi/twitch-scraper
APIFY_KICK_HLS_ACTOR=hipersoft/kick-downloader
APIFY_KICK_MP4_ACTOR=parsebird/kick-video-downloader
APIFY_STREAM_TIMEOUT_SECONDS=300
# Upper bound used by the last-resort full Kick download (minimum sent is 100 MB).
APIFY_KICK_MAX_VIDEO_SIZE_MB=2000
YOUTUBE_PROXY_COUNTRY=
YOUTUBE_PROXY_TIMEOUT_SECONDS=300
# bgutil PO-token sidecar. Empty skips it. In compose: http://bgutil:4416
YOUTUBE_POT_PROVIDER_URL=
# Per-job cap for audio + section bytes (and a full-file fallback). Default 2 GB.
YOUTUBE_DOWNLOAD_MAX_BYTES=2000000000
# Seconds of padding around each selected clip before ranges are merged.
YOUTUBE_SECTION_PADDING_SECONDS=10
# Video downloads never exceed 1080p. A lower value is honored.
YOUTUBE_MAX_HEIGHT=1080
# Keep audio and section files so edits do not download the source again.
YOUTUBE_SOURCE_CACHE=on
YOUTUBE_SOURCE_CACHE_TTL_SECONDS=604800
# RapidAPI download service (optional). Hosts stay in private configuration.
RAPIDAPI_YOUTUBE_API_KEY=
RAPIDAPI_YOUTUBE_HOST=
RAPIDAPI_YOUTUBE_RELAY_HOST=
RAPIDAPI_YOUTUBE_TIMEOUT_SECONDS=300

# YouTube metadata provider
# `yt_dlp` keeps the current behavior.
# `youtube_data_api` uses the official YouTube Data API first, then falls back to yt-dlp.
YOUTUBE_METADATA_PROVIDER=yt_dlp
# How long task creation waits for YouTube length metadata, in seconds.
# Default 30. Invalid values use 30; values above 180 are capped.
# Raise this (for example to 60) when valid links time out under amd64 emulation.
YOUTUBE_PREFLIGHT_TIMEOUT_SECONDS=30

# Preferred key for the YouTube Data API metadata path.
# If omitted, metadata requests fall back to GOOGLE_API_KEY when available.
YOUTUBE_DATA_API_KEY=

# ==============================================
# AI Model Configuration (local-first)
# ==============================================

# LLM and AI_EDIT_MODEL are configured in the Local AI section at the top of
# this file. Format: "provider:model-name". Only ollama:* runs offline.
#   - ollama:llama3.2:3b  (default, ~2 GB RAM)
#   - ollama:qwen2.5:3b   (alternative)
#   - openai:gpt-5.2      (hosted, opt-in only)

# Optional daily cap for AI editing requests.
# AI_EDIT_DAILY_LIMIT=150

# Stale queued tasks are marked as errors after this many seconds.
# Mark stale queued tasks as error after this many seconds
QUEUED_TASK_TIMEOUT_SECONDS=180

# Default target resolution requested from the Apify YouTube downloader when enabled
APIFY_YOUTUBE_DEFAULT_QUALITY=1080
# Maximum Apify actor run time before ClipWright Studio gives up and falls back, in seconds
APIFY_RUN_TIMEOUT_SECONDS=3600

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
# Hard cap on clips per task (all modes); fast mode can cap lower
MAX_CLIPS=10
FAST_MODE_MAX_CLIPS=10
FAST_MODE_TRANSCRIPT_MODEL=universal-3-5-pro
# Cut to the active speaker on multi-person wide shots (uses speaker labels)
SPEAKER_FRAMING=true
# Replay a later line before each clip. Off by default: the line plays twice
# and the real opening has to work on its own. Set true to opt into cold opens.
HOOK_FIRST_TEASER=false

# ==============================================
# Authentication
# ==============================================

# Better Auth secret (change this in production!)
# Generate a secure random string for production
BETTER_AUTH_SECRET=supoclip_dev_secret_change_in_production

# Set to true/1/yes to disable new user sign-ups.
DISABLE_SIGN_UP=false

# Set to true to disable all routes except the landing page.
NEXT_PUBLIC_LANDING_ONLY_MODE=false

# ==============================================
# Analytics (optional)
# ==============================================

# DataFast public website ID (example: dfid_xxxxxx)
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=

# DataFast tracked domain without protocol (example: clipwright.example)
NEXT_PUBLIC_DATAFAST_DOMAIN=

# Set to true only when you want to test DataFast on localhost
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false

# Tilly analytics (optional, runs alongside DataFast). Website id from Tilly's site settings.
NEXT_PUBLIC_TILLY_WEBSITE_ID=

# ==============================================
# Error tracking and logs (optional, see docs/observability.md)
# ==============================================

# PostHog project token (phc_...). Empty disables error reporting from the
# backend and worker.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Web analytics, session replay and error tracking. Baked in at build time;
# empty disables PostHog in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Upload web source maps at build time (personal API key with error tracking
# write + organization read scopes, and the numeric project id).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Ship container logs to Axiom: set COMPOSE_PROFILES=axiom and an ingest token.
# COMPOSE_PROFILES=axiom
AXIOM_TOKEN=
AXIOM_DATASET=supoclip-prod

# Amazon SES credentials for transactional emails; required to verify email and create API keys
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL="ClipWright Studio <onboarding@example.com>"
# Docker host port. Existing deployments without this setting keep port 3001.
# Keep your existing port if a production reverse proxy depends on it.
FRONTEND_PORT=3107
NEXT_PUBLIC_APP_URL=http://localhost:3107
BETTER_AUTH_URL=http://localhost:3107
# Optional comma-separated browser origins for another hostname/custom port.
# Explicit HTTP(S) origins only; no wildcard or automatic request-host trust.
BETTER_AUTH_TRUSTED_ORIGINS=

# ==============================================
# Monetization (optional, disabled by default)
# ==============================================

# Open-source/self-host mode. Monetization is only enabled when SELF_HOST=false
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
APP_SETTINGS_ENCRYPTION_KEY=change_me_settings_encryption_secret
ALLOW_UNSIGNED_BACKEND_AUTH=false
AUTH_SIGNATURE_TTL_SECONDS=300
# Include the frontend origin because browser video uploads go directly to the backend.
CORS_ORIGINS=http://localhost:3107,http://sp.localhost:3107,http://supoclip.localhost:3107


# Paid plan monthly allowance, in minutes of source video (0 = unlimited).
# Pro clips are delivered at 720p, Creator ("scale") clips at 1080p.
PRO_PLAN_MINUTE_LIMIT=600
SCALE_PLAN_MINUTE_LIMIT=1500

# Source-video duration limits, in seconds. Scale's longer allowance applies
# only to YouTube links from active or trialing Scale subscriptions.
MAX_VIDEO_DURATION=5400
PRO_YOUTUBE_MAX_VIDEO_DURATION=5400
SCALE_YOUTUBE_MAX_VIDEO_DURATION=10800

# Stripe settings (required only when SELF_HOST=false)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy fallback for the Pro price ID. Prefer STRIPE_PRO_PRICE_ID for new setups.
STRIPE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
# Yearly prices (optional; the yearly option fails checkout until they are set)
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_SCALE_ANNUAL_PRICE_ID=
# Earlier prices existing subscribers still pay (comma-separated). They keep
# mapping to their plan; subscribers on an earlier Pro price keep 1080p.
STRIPE_PRO_LEGACY_PRICE_IDS=
STRIPE_SCALE_LEGACY_PRICE_IDS=
# Creator program: coupon that approved creators' promotion codes are attached to
# (20% off for the first 3 months).
STRIPE_CREATOR_COUPON_ID=creator-20-3mo
NEXT_PUBLIC_PRO_PRICE_MONTHLY=9.99
NEXT_PUBLIC_SCALE_PRICE_MONTHLY=24.99
NEXT_PUBLIC_PRO_PRICE_ANNUAL=99.90
NEXT_PUBLIC_SCALE_PRICE_ANNUAL=249.90
NEXT_PUBLIC_PRO_PLAN_MINUTE_LIMIT=600
NEXT_PUBLIC_SCALE_PLAN_MINUTE_LIMIT=1500
# Scheduled posting on the pricing pages: soon (default, "Coming soon" tag), live, or off
NEXT_PUBLIC_SOCIAL_PUBLISHING=soon

# Optional fallback links when Stripe sessions are not configured
STRIPE_CHECKOUT_URL=
STRIPE_CUSTOMER_PORTAL_URL=

# RevenueCat Apple IAP webhook settings (handled by the frontend Next.js route)
REVENUECAT_WEBHOOK_AUTH_HEADER=
# Optional comma-separated product ID overrides/additions. Defaults are:
# com.samihindi.supoclip.pro.monthly and com.samihindi.supoclip.scale.monthly
REVENUECAT_PRO_PRODUCT_IDS=
REVENUECAT_SCALE_PRODUCT_IDS=

# ==============================================
# Feedback (optional — posts to Discord)
# ==============================================

# Discord webhook URLs (each posts to a separate channel)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# ==============================================
# Social Publishing (optional)
# ==============================================
# Register one OAuth app per platform; users then connect their own accounts
# in Settings -> Social Accounts. All three platform APIs are free; each one
# gates public posting behind an app review (see docs/configuration.md).
#
# Redirect URI to register for every platform:
#   ${NEXT_PUBLIC_APP_URL}/api/social/callback/<provider>   (youtube | tiktok | instagram)

# Google Cloud -> OAuth client (Web application), YouTube Data API v3 enabled
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# TikTok for Developers -> app with Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta for Developers -> app with "Instagram API with Instagram Login"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Where OAuth callbacks and Instagram's public video fetch land. Both default
# to NEXT_PUBLIC_APP_URL; override only if the frontend is reachable elsewhere.
SOCIAL_OAUTH_REDIRECT_BASE_URL=
SOCIAL_PUBLIC_MEDIA_BASE_URL=

# Performance loop: how often to pull metrics, for how long after publishing,
# and how many measured posts are needed before clip selection is personalized.
SOCIAL_METRICS_REFRESH_HOURS=6
SOCIAL_METRICS_MAX_POST_AGE_DAYS=60
SOCIAL_PERFORMANCE_MIN_POSTS=3

# Rollout: "off" (default; Social and Analytics stay hidden), "admins"
# (admins plus the allowlist only) or "all".
SOCIAL_PUBLISHING_ACCESS=off
# Platforms available to users admitted by the rollout above. Empty disables all.
# For a YouTube-only admin trial: ACCESS=admins, PROVIDERS=youtube, no allowlist.
SOCIAL_PUBLISHING_PROVIDERS=youtube,tiktok,instagram
# Comma-separated emails that get access when SOCIAL_PUBLISHING_ACCESS=admins.
SOCIAL_PUBLISHING_ALLOWED_EMAILS=

# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL credentials (matches docker-compose.yml)
POSTGRES_DB=supoclip
POSTGRES_USER=supoclip
POSTGRES_PASSWORD=supoclip_password

# Redis password for Docker/local development.
# Leave blank to run Redis without AUTH, or set a value to require authentication.
REDIS_PASSWORD=

# ==============================================
# Docker Performance
# ==============================================

# Enable BuildKit for faster Docker builds
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# Durable media: local for self-hosting, s3 for private object storage.
# IAM roles/default AWS credentials work when dedicated media keys are blank.
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_PREFIX=media
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
# Optional independent S3-compatible mirror (for example Cloudflare R2).
# Enable failover only after existing media has been copied and verified.
MEDIA_FALLBACK_BUCKET=
MEDIA_FALLBACK_ENDPOINT=
MEDIA_FALLBACK_REGION=auto
MEDIA_FALLBACK_ACCESS_KEY_ID=
MEDIA_FALLBACK_SECRET_ACCESS_KEY=
MEDIA_FAILOVER_ENABLED=false
MEDIA_URL_TTL_SECONDS=900
MEDIA_CACHE_TTL_SECONDS=86400
MEDIA_ORPHAN_GRACE_SECONDS=86400
MEDIA_UPLOAD_CONCURRENCY=3
MEDIA_UPLOAD_DAILY_LIMIT=20

# Explicit deployment configuration; no paid worker is selected by default.
APIFY_YOUTUBE_DOWNLOADER_ACTOR=
# Legacy input contracts: start_urls, progressive, kv_videos.
APIFY_YOUTUBE_INPUT_ADAPTER=start_urls

# Private provider pool: actor, pinned build, adapter, optional max_charge_usd
# and run_timeout_seconds. Adapters: kv_file, url_objects, signed_url,
# kv_media, private_s3. No paid worker is selected by default.
APIFY_YOUTUBE_PROVIDERS=[]
# Ordered actor IDs, comma separated; at most three providers including primary.
APIFY_YOUTUBE_FALLBACK_ACTORS=
# Legacy single fallback, used only when the ordered list is empty.
APIFY_YOUTUBE_FALLBACK_ACTOR=
# Shared per-download Apify spending allowance across all providers (USD, max 6).
APIFY_DOWNLOAD_MAX_CHARGE_USD=6
APIFY_FALLBACK_MAX_CHARGE_USD=6
# Fallback actors beyond the primary stay off (they can cost up to $6 per run).
# Set true only when those actors are an intentional, budgeted backup.
APIFY_EXPENSIVE_FALLBACKS=false

# Optional private delivery: versioning required; scope credentials to one bucket.
APIFY_STORAGE_BUCKET=
APIFY_STORAGE_REGION=
APIFY_STORAGE_WRITER_ACCESS_KEY_ID=
APIFY_STORAGE_WRITER_SECRET_ACCESS_KEY=
APIFY_STORAGE_READER_ACCESS_KEY_ID=
APIFY_STORAGE_READER_SECRET_ACCESS_KEY=
APIFY_STORAGE_KEY_TEMPLATE=
